{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Joourney",
  "version": "0.1.0",
  "identifier": "com.joourney.app",
  "build": {
    "frontendDist": "https://joourney-seven.vercel.app/",
    "devUrl": "https://joourney-seven.vercel.app/"
  },
  "app": {
    "windows": [
      {
        "title": "Joourney",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#1e293b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
